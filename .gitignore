conn-holder-e2e
conn-holder-test
draining-test
exec-reload-integration
exec-reload-test
handoff-test
holder-client-compile-test
holder-integration-test
holder-local-engine-test
# engine/ + backend/ + common/ — D sources (engine/source, backend/source, common/source, views); binaries ignored via irc-fiber* patterns above
zig-engine-*.tar.gz
*.pyc
__pycache__/
frontend/wasm-img2irc/target/

# Lake build artifacts
**/.lake/

# Local OVH backups (72M+ each, never commit)
backups/
