# {{ ansible_managed }}
# IRC Fiber — gateway env file
# The gateway reaches Mongo & Redis via the Tailscale IP of the host they
# live on. The engine(s) do the same, pointing at the backend host's IP.

# Passwords are URL-encoded. The D libraries (vibe-d) decode percent-encoded
# characters in the connection-string userinfo, so urlencode is the right
# transform. Caveat: keep the underlying passwords URL-safe (alphanumeric).
#
# IMPORTANT: the D gateway/engine URL parser uses `lastIndexOf("/")` to
# extract the database name, so anything after the last `/` is treated as
# the DB name. Do NOT add `?authSource=...` query params — they get
# concatenated to the DB name. The user lives in the ircfiber DB so the
# default authSource is correct.
#
# Redis: the D library can't pass a password to connectRedis(); we rely
# on Tailscale network isolation (the redis container is bound only to
# the host's tailscale0 interface) instead of an in-protocol password.
IRCFIBER_REDIS_URL=redis://{{ backend_tailscale_ip | default(host_tailscale_ip | default('127.0.0.1')) }}:{{ redis_port }}/0
IRCFIBER_MONGO_URL=mongodb://{{ vault_mongo_app_username | urlencode }}:{{ vault_mongo_app_password | urlencode }}@{{ backend_tailscale_ip | default(host_tailscale_ip | default('127.0.0.1')) }}:{{ mongo_port }}/{{ mongo_initdb_database }}
{% if mullvad_sidecars is defined and mullvad_sidecars | length > 0 %}
IRCFIBER_MULLVAD_POOL={% for sc in mullvad_sidecars %}socks5://tailscale-mullvad-{{ sc.name }}:{{ sc.port | default(1055) }}{% if not loop.last %},{% endif %}{% endfor %}
{% endif %}
IRCFIBER_CONFIG_PATH=/config/prod.conf
{% if ircfiber_admin_password_reset | length > 0 %}
IRCFIBER_ADMIN_PASSWORD={{ ircfiber_admin_password_reset }}
{% endif %}
