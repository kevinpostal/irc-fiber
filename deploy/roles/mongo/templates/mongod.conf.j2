# {{ ansible_managed }}
# IRC Fiber — MongoDB configuration
# Bound ONLY to the host's Tailscale IPv4 address ({{ mongo_bind_ip }}).
# The container runs in network_mode: host, so this controls the daemon's bind.

storage:
  dbPath: /data/db

systemLog:
  destination: file
  path: /var/log/mongodb/mongod.log
  logAppend: true

net:
  port: {{ mongo_port }}
  bindIp: 0.0.0.0
  bindIpAll: false

processManagement:
  fork: false
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: enabled
