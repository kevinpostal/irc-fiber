    {
      "id": "row-footer",
      "panelTypes": "row",
      "title": "Recent activity"
    },
    {
      "id": "recent-errors",
      "panelTypes": "list",
      "title": "Recent errors",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "queryName": "A",
            "dataSource": "logs",
            "filter": {"expression": "severity_text = ERROR"},
            "filters": {"items": [{"key": {"key": "severity_text", "type": "tag"}, "op": "=", "value": "ERROR"}], "op": "AND"},
            "groupBy": [],
            "having": {"expression": ""},
            "orderBy": [{"columnName": "timestamp", "order": "desc"}],
            "limit": 20,
            "selectFields": [
              {"name": "service.name", "field": "service.name", "fieldDataType": "string", "type": ""},
