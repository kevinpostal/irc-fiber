            "filter": {"expression": ""},
            "filters": {"items": [], "op": "AND"},
            "groupBy": [{"key": "state", "dataType": "string", "type": "tag"}],
            "having": {"expression": ""},
            "orderBy": [],
            "limit": null,
            "stepInterval": 30
          }],
          "queryFormulas": []
        },
        "promql": [{"name": "A", "query": "", "disabled": false}],
        "clickhouse_sql": [{"name": "A", "query": "", "disabled": false}]
