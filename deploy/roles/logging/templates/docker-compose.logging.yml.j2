# {{ ansible_managed }}
# IRC Fiber — SigNoz-native observability stack.
#
#   Fluent Bit → signoz-ingester (OTLP HTTP) → signoz (combined image)
#                  ↓
#               clickhouse (separate, fed by the combined signoz image
#                            via SIGNOZ_CLICKHOUSE_HOST=clickhouse:9000)
#   Grafana reads from signoz:8080 (query-service API)
#
# The signoz service is the signoz/signoz combined image (query-service
# + frontend + alertmanager) — but unlike the "Foundry" builds, we run
# ClickHouse as a SEPARATE container (the clickhouse service below) and
# point the signoz image at it via env. This decouples ClickHouse from
# signoz so we can back up / scale / replace the image without losing
# telemetry data, and so the local-dev compose can use the same layout.
#
# The signoz-ingester is a separate otel/opentelemetry-collector-contrib
# container that accepts OTLP from Fluent Bit + the bridge collector and
# forwards to signoz. Running it as a sidecar lets us apply log
# redaction / sampling / New Relic entity model transforms in one place.
#
# All services run on the ircfiber_logging network (separate from
# ircfiber_net so observability traffic doesn't compete with IRC control).
#
# Resource budgets:
#   Fluent Bit:        128MB RAM, 0.5 CPU
#   Signoz-ingester:   256MB RAM, 0.5 CPU
#   Signoz (combined): 1GB  RAM, 1.0 CPU (query-svc + frontend + alertmanager)
#   ClickHouse:        1GB  RAM, 1.0 CPU
#   Grafana:           256MB RAM, 0.5 CPU
# Total:               ~2.6GB RAM, 3.5 CPU — fits on 7.7GB/4-core VPS.

x-logging-common: &logging-common
  restart: unless-stopped
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"
  healthcheck:
    disable: true

services:
  # ────────────────────────────────────────────────────────────────────────
  # Grafana — query UI (unchanged datasource provisioning deferred to w3-t1)
  # ────────────────────────────────────────────────────────────────────────
  grafana:
    <<: *logging-common
    container_name: ${GRAFANA_CONTAINER_NAME:-ircfiber-grafana}
    image: ${GRAFANA_IMAGE:-grafana/grafana:11.3.0}
    hostname: ircfiber-grafana
    networks:
      - ircfiber_logging
    # Internal-only — Caddy proxies /grafana/* to this container port.
    expose:
      - "3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_DISABLE_SIGNUP=${GRAFANA_DISABLE_SIGNUP}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_PROXY_ENABLED=${GF_AUTH_PROXY_ENABLED}
      - GF_AUTH_PROXY_HEADER_NAME=X-WebAuth-User
      - GF_AUTH_PROXY_HEADER_PROPERTY=username
      - GF_AUTH_PROXY_AUTO_SIGN_UP=true
      - GF_AUTH_PROXY_LDAP_ENABLED=false
      - GF_AUTH_ANONYMOUS_ENABLED=false
      - GF_SESSION_LIFETIME=${GRAFANA_SESSION_LIFETIME_MINUTES:-10080}
      - GF_SECURITY_COOKIE_SECURE=true
      - GF_SECURITY_COOKIE_SAMESITE=strict
      - GF_SERVER_ROOT_URL=${GF_SERVER_ROOT_URL}
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_USERS_DEFAULT_THEME=dark
      - GF_INSTALL_PLUGINS=
      - GF_FEATURE_TOGGLES_ENABLE=traceQLSearch,traces
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
    volumes:
      - ${GRAFANA_DATA_VOLUME}:/var/lib/grafana
      - /etc/ircfiber/grafana/provisioning:/etc/grafana/provisioning
      - /etc/ircfiber/grafana/dashboards:/var/lib/grafana/dashboards
      - ${GRAFANA_ALERTING_VOLUME}:/var/lib/grafana/alerting
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/api/health | grep -q ok || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    mem_limit: 256m
    cpus: 0.5

  # ────────────────────────────────────────────────────────────────────────
  # Fluent Bit — container log shipper via OTLP HTTP to SigNoz ingester.
  # ────────────────────────────────────────────────────────────────────────
  # Scrapes Docker JSON logs from /var/lib/docker/containers, enriches with
  # container metadata from the Docker socket, and forwards to the SigNoz
  # ingester on port 4318 (OTLP HTTP).
  fluent-bit:
    <<: *logging-common
    container_name: ${FLUENT_BIT_CONTAINER_NAME:-ircfiber-fluent-bit}
    image: ${FLUENT_BIT_IMAGE:-fluent/fluent-bit:3.2}
    hostname: ircfiber-fluent-bit
    networks:
      - ircfiber_logging
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - {{ fluent_bit_config_dir }}/fluent-bit.conf:/fluent-bit/etc/fluent-bit.conf:ro
      - {{ fluent_bit_config_dir }}/parsers.conf:/fluent-bit/etc/parsers.conf:ro
    entrypoint:
      - /fluent-bit/bin/fluent-bit
      - -c
      - /fluent-bit/etc/fluent-bit.conf
    healthcheck:
      test: ["CMD-SHELL", "pgrep fluent-bit || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    depends_on:
      - signoz
    mem_limit: ${FLUENT_BIT_MEMORY_LIMIT:-128m}
    cpus: ${FLUENT_BIT_CPU_LIMIT:-0.5}

  # ────────────────────────────────────────────────────────────────────────
  # SigNoz combined image — one-container SigNoz with ClickHouse bundled.
  # Exposes: API+UI on port 3301, REST API on 8080, OTLP on 4317/4318.
  # See deploy/local/docker-compose.yml for local-dev equivalent.
  # ────────────────────────────────────────────────────────────────────────
  signoz:
    <<: *logging-common
    container_name: ${SIGNOZ_CONTAINER_NAME:-ircfiber-signoz}
    image: ${SIGNOZ_IMAGE:-signoz/signoz:{{ signoz_version }}}
    hostname: signoz
    networks:
      ircfiber_logging:
        aliases:
          - signoz
          - signoz-ingester
    ports:
      - "3301:3301"
      - "8080:8080"
    environment:
      SIGNOZ_INITIAL_ADMIN_EMAIL: admin@ircfiber.com
      SIGNOZ_INITIAL_ADMIN_PASSWORD: admin123
      # SigNoz v0.131+ replaced SIGNOZ_CLICKHOUSE_HOST/PORT/DATABASE with
      # the nested telemetrystore.clickhouse.{dsn,provider} config keys,
      # populated from env vars with the SIGNOZ_ prefix:
      #   SIGNOZ_TELEMETRYSTORE_PROVIDER          → telemetrystore.provider
      #   SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN    → telemetrystore.clickhouse.dsn
      # The old STORAGE / ClickHouseUrl env vars are still backported by
      # the binary for compatibility, but the per-key host/port vars are
      # SILENTLY IGNORED — the binary falls back to its default DSN
      # tcp://localhost:9000 which can't be reached from inside the
      # container, breaking every query with "dial tcp [::1]:9000:
      # connect: connection refused".
      SIGNOZ_TELEMETRYSTORE_PROVIDER: clickhouse
      SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN: tcp://clickhouse:9000
      # Disable telemetry / usage reporting (stats reporter).
      TELEMETRY_ENABLED: "false"
      # Without a JWT secret the binary logs a CRITICAL SECURITY ISSUE
      # warning and refuses to sign session tokens properly. Without
      # this, every login attempt after a fresh deploy fails with
      # "no signing key configured".
      SIGNOZ_TOKENIZER_JWT_SECRET: ${SIGNOZ_JWT_SECRET}
    depends_on:
      - clickhouse
    volumes:
      - ${SIGNOZ_DATA_VOLUME:-ircfiber_signoz_data}:/var/lib/signoz
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/api/v1/health 2>&1 | grep -q ok || exit 1"
        ]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 120s
    mem_limit: 2g
    cpus: 2.0

  # ────────────────────────────────────────────────────────────────────────
  # ClickHouse — columnar storage for SigNoz traces, logs, and metrics
  # ────────────────────────────────────────────────────────────────────────
  clickhouse:
    <<: *logging-common
    container_name: ${CLICKHOUSE_CONTAINER_NAME:-ircfiber-clickhouse}
    image: ${CLICKHOUSE_IMAGE:-{{ signoz_clickhouse_image }}}
    hostname: clickhouse
    networks:
      ircfiber_logging:
        aliases:
          - clickhouse
    expose:
      - "9000"
      - "8123"
    environment:
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
      CLICKHOUSE_SKIP_USER_SETUP: 1
      CLICKHOUSE_MAX_MEMORY_USAGE: 8000000000
    volumes:
      - ${CLICKHOUSE_DATA_VOLUME:-ircfiber_clickhouse_data}:/var/lib/clickhouse
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8123/ping | grep -q Ok || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
    mem_limit: 1g
    cpus: 1.0

  # ────────────────────────────────────────────────────────────────────────
  # signoz-ingester — OTel collector receiving OTLP from Fluent Bit & bridge
  # Accepts OTLP gRPC on 4317 and HTTP on 4318, exports via the OTel
  # clickhouse exporter to the clickhouse service below (port 9000).
  # ────────────────────────────────────────────────────────────────────────
  signoz-ingester:
    <<: *logging-common
    container_name: ${SIGNOZ_INGESTER_CONTAINER_NAME:-ircfiber-signoz-ingester}
    image: ${SIGNOZ_INGESTER_IMAGE:-{{ signoz_ingester_image }}}
    hostname: signoz-ingester
    networks:
      ircfiber_logging:
        aliases:
          - signoz-ingester
    ports:
      - "4317:4317"
      - "4318:4318"
    volumes:
      - {{ fluent_bit_config_dir }}/otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    command:
      - --config=/etc/otel-collector-config.yaml
    # The otel/opentelemetry-collector-contrib image is **distroless** —
    # no shell, no wget, no nc. The previous `CMD-SHELL, wget ...`
    # healthcheck ALWAYS failed (`exec: /bin/sh: no such file`), so
    # Docker marked the container unhealthy even when the collector was
    # happily accepting OTLP. Docker compose v2 healthcheck only supports
    # `CMD`, `CMD-SHELL`, and `NONE` — and the `PORT` test type isn't in
    # any release. We use the otel-collector binary's `validate` subcommand
    # as a config-validity probe (exit 0 if /etc/otel-collector-config.yaml
    # parses cleanly, exit 1 otherwise). It's not a liveness probe — a
    # real liveness check would require shelling, which the image
    # doesn't allow. If the config is broken, we WANT the container
    # marked unhealthy so it shows up in `docker ps`. If the collector
    # process crashes mid-flight, `restart: unless-stopped` (via the
    # `x-logging-common` anchor) brings it back; the bridge collector
    # will show connection-refused if the OTLP listener is down, which
    # is the real liveness signal at the application layer.
    # Distroless image — binary is /signoz-otel-collector, no shell/wget.
    # No validate subcommand exists. restart: unless-stopped handles crashes.
    # Application-level liveness: OTel collector shows connection-refused
    # to OTLP if the listener is down, surfaced via the bridge logs.
    healthcheck:
      disable: true
    # Wait for clickhouse (not signoz) — the clickhouse exporter dials
    # clickhouse:9000 directly. The exporter's retry_on_failure handles
    # the ClickHouse init race (ClickHouse takes ~10s to be ready after
    # the container starts). condition: service_started (not
    # service_healthy) is enough since the clickhouse healthcheck is its
    # own subsystem; the exporter's retry loop covers the rest.
    depends_on:
      clickhouse:
        condition: service_started
    mem_limit: 256m
    cpus: 0.5

networks:
  ircfiber_logging:
    name: ircfiber_logging
    external: true

# All volumes are pre-created by the logging role's
# `community.docker.docker_volume` task and tagged external so compose
# does NOT try to create or delete them on `down`.
volumes:
  ircfiber_grafana_data:
    external: true
  ircfiber_grafana_provisioning:
    external: true
  ircfiber_grafana_dashboards:
    external: true
  ircfiber_grafana_alerting:
    external: true
  ircfiber_grafana_plugins:
    external: true
  ircfiber_signoz_data:
    external: true
  ircfiber_clickhouse_data:
    external: true
