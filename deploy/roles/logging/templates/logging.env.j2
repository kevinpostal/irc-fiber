# {{ ansible_managed }}
# Environment variables for the logging stack (Fluent Bit + SigNoz Foundry + Grafana).
# Sourced by docker-compose automatically when present in the same dir.

# ─── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_CONTAINER_NAME={{ grafana_container_name }}
GRAFANA_IMAGE={{ grafana_image }}
GRAFANA_DATA_VOLUME={{ grafana_data_volume }}
GRAFANA_PROVISIONING_VOLUME={{ grafana_provisioning_volume }}
GRAFANA_DASHBOARDS_VOLUME={{ grafana_dashboards_volume }}
GRAFANA_ALERTING_VOLUME={{ grafana_alerting_volume }}
GRAFANA_PLUGIN_VOLUME={{ grafana_plugins_volume }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_DISABLE_SIGNUP={{ grafana_disable_signup | string | lower }}
GRAFANA_SESSION_LIFETIME_MINUTES={{ grafana_session_lifetime_days | default(7) * 1440 }}
# Trust the auth-proxy header (set by Caddy) instead of basic auth.
# Only safe when Caddy is the ONLY ingress to Grafana.
GF_AUTH_PROXY_ENABLED={{ grafana_auth_proxy_enabled | string | lower }}
GF_SERVER_ROOT_URL={{ grafana_root_url }}

# ─── SigNoz combined image ──────────────────────────────────────────────
SIGNOZ_IMAGE=signoz/signoz:{{ signoz_version }}
SIGNOZ_CONTAINER_NAME={{ signoz_container_name }}
SIGNOZ_DATA_VOLUME={{ signoz_data_volume }}

# ─── Fluent Bit ──────────────────────────────────────────────────────────
FLUENT_BIT_CONTAINER_NAME={{ fluent_bit_container_name }}
FLUENT_BIT_IMAGE=fluent/fluent-bit:{{ fluent_bit_version }}
FLUENT_BIT_MEMORY_LIMIT={{ fluent_bit_memory_limit }}
FLUENT_BIT_CPU_LIMIT={{ fluent_bit_cpu_limit }}
