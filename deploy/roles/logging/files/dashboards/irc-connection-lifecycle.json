{
  "annotations": {
    "list": []
  },
  "description": "IRC engine connection lifecycle: TCP open, TLS handshake, REGISTER, CAP negotiation, SASL auth, welcome, disconnects, reconnect attempts. One row per network.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "type": "row",
      "title": "Connection events timeline",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "id": 100,
      "panels": []
    },
    {
      "id": 1,
      "title": "Connection events by type (rate / sec)",
      "type": "timeseries",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 1},
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "color": {"mode": "palette-classic"}
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "Loki"},
          "expr": "sum by (event) (rate({job=\"ircfiber_containers\", component=\"engine-ovh\", event=~\"tcp_open|tls_handshake|register_sending|register_complete|welcome|cap_negotiating|cap_negotiated|sasl_authenticate|sasl_success|sasl_fail|disconnected|reconnect_scheduled|reconnect_attempt\"}[$__interval]))",
          "legendFormat": "{{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-network",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 10},
      "collapsed": false,
      "id": 101,
      "panels": []
    },
    {
      "id": 2,
      "title": "TCP / TLS / register success rate (last 1h)",
      "type": "stat",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 11},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "Loki"},
          "expr": "sum(count_over_time({job=\"ircfiber_containers\", event=\"tcp_open\"}[1h]))",
          "legendFormat": "TCP opens",
          "queryType": "range",
          "refId": "A"
        }
