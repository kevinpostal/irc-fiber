# {{ ansible_managed }}
# Ergo IRC daemon configuration
# Generated by Ansible for {{ ircd_server_name }}

network:
    name: "{{ ircd_network_name | lower | replace(' ', '') }}"

server:
    name: "{{ ircd_server_name }}"
    casemapping: "ascii"
    check-ident: false
    max-sendq: 96k

    listeners:
        # Plaintext IRC
        ":{{ ircd_port_plain }}":
        # TLS IRC
        ":{{ ircd_port_tls }}":
            tls:
                cert: fullchain.pem
                key: privkey.pem
            proxy: false

    ip-cloaking:
        enabled: true
        netname: "ircfiber"

    ip-limits:
        count: false
        max-concurrent-connections: {{ ircd_ip_limits_connections }}
        throttle: false
        window: "{{ ircd_ip_limits_duration }}"
        max-connections-per-window: 32
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        exempted:
            - "172.30.0.0/16"
            - "localhost"
    motd: "{{ ircd_data_mount }}/motd"
    motd-formatting: true
    proxy-allowed-from:
        - localhost

    sts:
        enabled: false
        duration: 0

accounts:
    authentication-enabled: true
    registration:
        enabled: {{ ircd_allow_registration | lower }}
        allow-before-connect: true
        throttling:
            enabled: false
            duration: 10m
            max-attempts: 30
        bcrypt-cost: 4
        verify-timeout: "32h"
        email-verification:
            enabled: false
            sender: "{{ ircd_admins[0].email if ircd_admins | length > 0 else 'admin@ircfiber.com' }}"
    login-throttling:
        enabled: false
        duration: 1m
    login-via-pass-command: true
    require-sasl:
        enabled: {{ ircd_require_sasl | lower }}
        exempted:
            - "172.30.0.0/16"
            - "localhost"
    nick-reservation:
        enabled: true
        additional-nick-limit: {{ ircd_max_nicks_per_account - 1 }}
        method: strict
        allow-custom-enforcement: false
        force-nick-equals-account: true
        guest-nickname-format: "Guest-*"
    multiclient:
        enabled: true
        allowed-by-default: true
        always-on: "opt-in"
        auto-away: "opt-in"
    vhosts:
        enabled: true
        max-length: 64
    default-user-modes: +i

channels:
    default-modes: +nt
    max-channels-per-client: {{ ircd_max_channels_per_account }}
    operator-only-creation: false
    registration:
        enabled: true
        operator-only: false
        max-channels-per-account: {{ ircd_max_channels_per_account }}
    invite-expiration: 24h
{% if ircd_default_channels | length > 0 %}
    auto-join:
{% for ch in ircd_default_channels %}
        - "{{ ch }}"
{% endfor %}
{% endif %}

oper-classes:
    "server-admin":
        title: Server Admin
        extends: "chat-moderator"
        capabilities:
            - "rehash"
            - "accreg"
            - "chanreg"
            - "history"
            - "defcon"
            - "massmessage"
            - "metadata"
    "chat-moderator":
        title: Chat Moderator
        capabilities:
            - "kill"
            - "ban"
            - "nofakelag"
            - "relaymsg"
            - "vhosts"
            - "sajoin"
            - "samode"
            - "snomasks"
            - "roleplay"

{% if vault_ircd_oper_password_hash is defined and vault_ircd_oper_password_hash | length > 0 %}
opers:
    "{{ ircd_oper_name }}":
        class: "server-admin"
        hidden: true
        whois-line: is the server administrator
        password: "{{ vault_ircd_oper_password_hash }}"
{% endif %}

logging:
    - method: stderr
      type: "* -userinput -useroutput"
      level: "{{ ircd_log_level }}"

history:
    enabled: true
    channel-length: 2048
    client-length: 256
    autoreplay-on-join: 0
    chathistory-maxmessages: 1000
    znc-maxmessages: 2048
    restrictions:
        expire-time: 1w

datastore:
    path: "{{ ircd_data_mount }}/db"
    autoupgrade: true

debug:
    recover-from-errors: true

fakelag:
    enabled: false
    window: 1s
    burst-limit: 5
    messages-per-window: 2
    cooldown: 2s

limits:
    nicklen: 32
    identlen: 20
    channellen: 64
    awaylen: 390
    kicklen: 390
    topiclen: 390

languages:
    enabled: true
    default: en
    path: /ircd-bin/languages

allow-environment-overrides: true
